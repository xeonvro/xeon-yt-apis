PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Scraper
CONVERTER_URL=https://ht.flvto.online/converter
CONVERTER_ORIGIN=https://ht.flvto.online
MAX_RETRIES=12
RETRY_DELAY_MS=5000
REQUEST_TIMEOUT_MS=15000
CACHE_TTL_MS=3600000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional: remap converter fileType values if upstream changes
# FILE_TYPE_480=480
# FILE_TYPE_720=720
# FILE_TYPE_1080=1080
